{
  "schema": "veyra-signal-profile-v1",
  "id": "synthetic-bev-ros",
  "version": "1",
  "synthetic": true,
  "title": "SYNTHETIC battery-electric vehicle (generated ROS recordings for demonstration)",
  "machine_class": "battery_electric_vehicle",
  "conditions": {"has_hv_contactors": true},
  "note": "Matches only recordings generated by scripts/make_synthetic_bev_recording.py (topics under /synthetic_bev). Any recording it matches is labelled SYNTHETIC.",
  "recording": {
    "formats": ["ros1_bag", "ros2_bag", "mcap"],
    "bind": {
      "battery": {"topic": "/synthetic_bev/battery", "types": ["sensor_msgs/msg/BatteryState", "sensor_msgs/BatteryState"]},
      "fault": {"topic": "/synthetic_bev/bms_fault_level"},
      "contactors": {"topic": "/synthetic_bev/contactors_closed"},
      "cells": {"topic": "/synthetic_bev/cell_voltage_min"}
    },
    "time": "log (receive) time, seconds from the first message of the recording"
  },
  "max_sample_age_s": 0.5,
  "max_gap_s": 1.0,
  "roles": {
    "pack_current": {"field": "battery:current", "unit": "A", "sign": "charge_positive", "kind": "measurement", "valid": [-1000, 1000]},
    "soc": {"field": "battery:percentage", "unit": "fraction", "kind": "estimate", "estimator": "coulomb_counting", "valid": [0, 1], "resolution": 0.004},
    "rated_capacity": {"field": "battery:capacity", "unit": "Ah", "kind": "reported_parameter", "valid": [1, 1000]},
    "pack_voltage": {"field": "battery:voltage", "unit": "V", "kind": "measurement", "valid": [0, 1000]},
    "bms_fault_level": {"field": "fault:data", "unit": "", "kind": "state", "map": {"0": 0, "1": 1, "2": 2, "3": 3, "4": 4}},
    "main_positive_closed": {"field": "contactors:data", "unit": "", "kind": "state"},
    "main_negative_closed": {"field": "contactors:data", "unit": "", "kind": "state"},
    "min_cell_voltage": {"field": "cells:data", "unit": "V", "kind": "measurement", "valid": [1.0, 5.0]}
  },
  "parameters": {}
}
