{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "engine-v2-machine-context-ledger": false,
      "private-instance-local": false
    }
  },
  "rewrites": [
    {
      "source": "/api/engine/:path*",
      "destination": "https://veyra-demo-api.onrender.com/:path*"
    }
  ]
}
