# Veyra environment
#
# Local defaults work without external services.

# Backend
DATABASE_URL=sqlite:///./veyra.db
VEYRA_AUTO_SEED=true
FILE_STORAGE_BACKEND=local
UPLOAD_ROOT=uploaded_recordings

# Neon Postgres
# Copy your Neon pooled connection string and use the SQLAlchemy psycopg driver.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require

# Cloudflare R2 or another S3-compatible store
# FILE_STORAGE_BACKEND=r2
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=veyra-uploads
# AWS_ACCESS_KEY_ID=<r2-access-key-id>
# AWS_SECRET_ACCESS_KEY=<r2-secret-access-key>
# AWS_REGION=auto
# S3_PREFIX=field-case-uploads

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8050
